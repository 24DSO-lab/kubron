+
+import (
+	"context"
+	"io/fs"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/24DSO-lab/kubron/internal/baseline"
+	"github.com/24DSO-lab/kubron/internal/baseline/baselinetest"
+	"github.com/24DSO-lab/kubron/internal/tenant"
+)
+
+func newFileEnv(t *testing.T) baselinetest.Env {
+	t.Helper()
+	var n atomic.Int64
+	return baselinetest.Env{
+		Backend: baseline.NewFileBackend(filepath.Join(t.TempDir(), "baselines")),
+		NewScope: func(t *testing.T) tenant.Scope {
+			return tenant.Scope{OrgID: "local", TeamID: "default", ClusterID: "cluster-" + strconv.FormatInt(n.Add(1), 10)}
+		},
+	}
+}
+
+// Контракт Backend (общий для файловой и PostgreSQL реализаций).
+func TestFileBackendContract(t *testing.T) { baselinetest.Run(t, newFileEnv) }
+
+// Файлы создаются с правами не шире, чем у users.json и audit.log, без временных остатков.
+func TestFileBackendPermissionsAndNoTempFiles(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("POSIX permission bits")
+	}
+	root := filepath.Join(t.TempDir(), "baselines")
+	b := baseline.NewFileBackend(root)
+	s := tenant.Scope{OrgID: "local", TeamID: "default", ClusterID: "c1"}
+	bl := baseline.Baseline{ID: "b1", Scope: s, Name: "x", CreatedBy: "a", CreatedAt: time.Now()}
+	if err := b.PutBaseline(context.Background(), bl); err != nil {
+		t.Fatal(err)
+	}
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		info, err := d.Info()
+		if err != nil {
+			return err
+		}
+		perm := info.Mode().Perm()
+		if d.IsDir() && perm&0o077 != 0 {
+			t.Errorf("directory %s has permissions %o", path, perm)
+		}
+		if !d.IsDir() && perm&0o077 != 0 {
+			t.Errorf("file %s has permissions %o", path, perm)
+		}
+		if !d.IsDir() && filepath.Base(path)[0] == '.' {
+			t.Errorf("temporary file left behind: %s", path)
+		}
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+}
+
+// Повреждённый файл не превращается в «нет данных» и не роняет процесс.
+func TestFileBackendCorruptedFile(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "baselines")
+	b := baseline.NewFileBackend(root)
+	s := tenant.Scope{OrgID: "local", TeamID: "default", ClusterID: "c1"}
+	bl := baseline.Baseline{ID: "b1", Scope: s, Name: "x", CreatedBy: "a", CreatedAt: time.Now()}
+	if err := b.PutBaseline(context.Background(), bl); err != nil {
+		t.Fatal(err)
+	}
+	path := filepath.Join(root, "local", "default", "c1", "b1", "baseline.json")
+	if err := os.WriteFile(path, []byte("{not json"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	_, err := b.GetBaseline(context.Background(), s, "b1")
+	if err == nil || err == baseline.ErrNotFound {
+		t.Fatalf("a corrupted file must be an error, not a missing record: %v", err)
+	}
+}
+
+// Документ, подложенный в каталог чужой области, не отдаётся (защита в глубину).
+func TestFileBackendForeignDocumentInOwnDirectory(t *testing.T) {
+	root := filepath.Join(t.TempDir(), "baselines")
+	b := baseline.NewFileBackend(root)
+	owner := tenant.Scope{OrgID: "local", TeamID: "default", ClusterID: "c1"}
+	other := tenant.Scope{OrgID: "local", TeamID: "default", ClusterID: "c2"}
+	bl := baseline.Baseline{ID: "b1", Scope: other, Name: "x", CreatedBy: "a", CreatedAt: time.Now()}
+	if err := b.PutBaseline(context.Background(), bl); err != nil {
+		t.Fatal(err)
+	}
+	// Копируем документ чужого кластера в каталог своего.
+	raw, err := os.ReadFile(filepath.Join(root, "local", "default", "c2", "b1", "baseline.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	dst := filepath.Join(root, "local", "default", "c1", "b1")
+	if err := os.MkdirAll(dst, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dst, "baseline.json"), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := b.GetBaseline(context.Background(), owner, "b1"); err != baseline.ErrNotFound {
+		t.Fatalf("error = %v, want ErrNotFound", err)
+	}
+}
diff --git a/internal/baseline/normalize.go b/internal/baseline/normalize.go
new file mode 100644
index 00000000..534ec37c
--- /dev/null
+++ b/internal/baseline/normalize.go
@@ -0,0 +1,119 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package baseline
+
+import (
+	"maps"
+	"slices"
+	"time"
+)
+
+// Методы Normalized приводят запись к каноническому виду хранилища: время в UTC с точностью до микросекунды,
+// пустые необязательные коллекции — nil, обязательные — непустые контейнеры (не null в JSON). Оба бэкенда применяют их
+// перед записью и после чтения, поэтому файловая и PostgreSQL реализации возвращают одно и то же значение
+// (иначе расхождение семантики было бы «особенностью режима», ADR-0026 §4). Методы идемпотентны и не меняют получателя.
+
+func normTimePtr(t *time.Time) *time.Time {
+	if t == nil {
+		return nil
+	}
+	n := Normalize(*t)
+	return &n
+}
+
+func emptyToNil[S ~[]E, E any](s S) S {
+	if len(s) == 0 {
+		return nil
+	}
+	return s
+}
+
+// Normalized — каноническая копия документа baseline.
+func (b Baseline) Normalized() Baseline {
+	b.CreatedAt = Normalize(b.CreatedAt)
+	b.Namespaces = emptyToNil(slices.Clone(b.Namespaces))
+	b.Kinds = emptyToNil(slices.Clone(b.Kinds))
+	b.Refs = slices.Clone(b.Refs)
+	if b.Refs == nil {
+		b.Refs = []Ref{}
+	}
+	return b
+}
+
+// Normalized — каноническая копия версии (содержимое глубоко копируется).
+func (v Version) Normalized() Version {
+	v.CreatedAt = Normalize(v.CreatedAt)
+	v.Salt = slices.Clone(v.Salt)
+	objs := make([]Object, 0, len(v.Objects))
+	for _, o := range v.Objects {
+		objs = append(objs, o.Normalized())
+	}
+	v.Objects = objs
+	return v
+}
+
+// Normalized — каноническая копия объекта: поля всегда карта (не nil), hash копируется.
+func (o Object) Normalized() Object {
+	fields := make(map[string]Field, len(o.Fields))
+	for k, f := range o.Fields {
+		if f.Hash != nil {
+			f.Hash = &HashedValue{HMAC: slices.Clone(f.Hash.HMAC)}
+		}
+		fields[k] = f
+	}
+	o.Fields = fields
+	return o
+}
+
+// Normalized — каноническая копия исключения.
+func (e Exception) Normalized() Exception {
+	e.CreatedAt = Normalize(e.CreatedAt)
+	e.ExpiresAt = normTimePtr(e.ExpiresAt)
+	return e
+}
+
+// NormalizedExceptions — каноническая копия списка исключений (пустой список — nil).
+func NormalizedExceptions(list []Exception) []Exception {
+	if len(list) == 0 {
+		return nil
+	}
+	out := make([]Exception, len(list))
+	for i, e := range list {
+		out[i] = e.Normalized()
+	}
+	return out
+}
+
+// Normalized — каноническая копия результата проверки.
+func (r CheckResult) Normalized() CheckResult {
+	r.CheckedAt = Normalize(r.CheckedAt)
+	items := make([]ItemResult, 0, len(r.Items))
+	for _, it := range r.Items {
+		it.Changes = emptyToNil(slices.Clone(it.Changes))
+		for i := range it.Changes {
+			if s := it.Changes[i].Source; s != nil {
+				c := *s
+				c.At = Normalize(c.At)
+				it.Changes[i].Source = &c
+			}
+		}
+		it.Suppressed = emptyToNil(slices.Clone(it.Suppressed))
+		items = append(items, it)
+	}
+	r.Items = items
+	if len(r.Summary.UncheckedByReason) == 0 {
+		r.Summary.UncheckedByReason = nil
+	} else {
+		r.Summary.UncheckedByReason = maps.Clone(r.Summary.UncheckedByReason)
+	}
+	applied := make([]AppliedException, len(r.Exceptions.Applied))
+	for i, a := range r.Exceptions.Applied {
+		a.ExpiresAt = normTimePtr(a.ExpiresAt)
+		applied[i] = a
+	}
+	r.Exceptions.Applied = emptyToNil(applied)
+	r.Exceptions.Expired = emptyToNil(slices.Clone(r.Exceptions.Expired))
+	r.Caveats = emptyToNil(slices.Clone(r.Caveats))
+	return r
+}
diff --git a/internal/baseline/result.go b/internal/baseline/result.go
new file mode 100644
index 00000000..495c8acd
--- /dev/null
+++ b/internal/baseline/result.go
@@ -0,0 +1,217 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package baseline
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/24DSO-lab/kubron/internal/tenant"
+)
+
+// Status — итог проверки одного ресурса (ADR-0027 §5).
+type Status string
+
+const (
+	// StatusMatch — «соответствует».
+	StatusMatch Status = "match"
+	// StatusChanged — «изменён»: есть отличия по нормализованным путям.
+	StatusChanged Status = "changed"
+	// StatusMissing — «отсутствует в кластере».
+	StatusMissing Status = "missing"
+	// StatusUnchecked — «не проверено»: нет прав Kubernetes, ошибка API, тип недоступен и т. п. Это не «соответствует».
+	StatusUnchecked Status = "unchecked"
+	// StatusNew — «новый ресурс вне baseline». Режим выключен и в MVP не реализован: значение зарезервировано, чтобы
+	// добавить режим без изменения контракта статусов.
+	StatusNew Status = "new"
+)
+
+// Reason — причина пропуска ресурса: «не проверено» при проверке, «не снято» при создании версии.
+type Reason string
+
+const (
+	ReasonForbidden         Reason = "forbidden"              // нет прав Kubernetes (или вне allowlist платформы)
+	ReasonUnavailable       Reason = "unavailable"            // ошибка API, таймаут, сеть
+	ReasonTooLarge          Reason = "too-large"              // ответ превысил лимит размера
+	ReasonKindUnavailable   Reason = "kind-unavailable"       // тип ресурса отсутствует в кластере
+	ReasonRulesMismatch     Reason = "rules-version-mismatch" // версия правил приложения не совпадает с версией baseline
+	ReasonSecretUnsupported Reason = "secret-unsupported"     // Secret не поддерживается и не читается
+	ReasonUnsupportedKind   Reason = "unsupported-kind"       // тип вне списка MVP
+	ReasonTruncated         Reason = "truncated"              // список ресурсов не поместился в лимит выборки
+	ReasonNotFound          Reason = "not-found"              // ресурс из явного списка отсутствует (при снимке)
+)
+
+// Priority — приоритет изменения по правилам типа (не AI): image, resources, securityContext выше labels.
+type Priority string
+
+const (
+	PriorityHigh   Priority = "high"
+	PriorityMedium Priority = "medium"
+	PriorityLow    Priority = "low"
+)
+
+// Rank — порядковый вес для сортировки (больше — важнее).
+func (p Priority) Rank() int {
+	switch p {
+	case PriorityHigh:
+		return 3
+	case PriorityMedium:
+		return 2
+	case PriorityLow:
+		return 1
+	default:
+		return 0
+	}
+}
+
+// ChangeOp — вид отличия пути.
+type ChangeOp string
+
+const (
+	OpChanged ChangeOp = "changed"
+	OpAdded   ChangeOp = "added"
+	OpRemoved ChangeOp = "removed"
+)
+
+// SourceKind — вид доказательства источника изменения (ADR-0027 §6).
+type SourceKind string
+
+const (
+	// SourceManagedFields — «по данным managedFields»: последний менеджер поля и время. Менеджер не приписывается
+	// пользователю: это имя клиента (kubectl, контроллер GitOps), а не человек.
+	SourceManagedFields SourceKind = "managedFields"
+	// SourceKubronAudit — запись аудита Kubron о применении YAML этим приложением, подтверждённая данными кластера.
+	SourceKubronAudit SourceKind = "kubron-audit"
+)
+
+// ChangeSource — доказательство источника изменения. Без доказательства источника нет (Change.Source == nil):
+// само отличие не доказывает, кто его внёс.
+type ChangeSource struct {
+	Kind SourceKind `json:"kind"`
+	// Manager — имя менеджера поля из managedFields (kubectl, argocd-controller…); человека не называет.
+	Manager string    `json:"manager,omitempty"`
+	At      time.Time `json:"at"`
+}
+
+// Change — одно отличие. Для чувствительных значений (Sensitive) содержимого нет: сообщается только, что значение
+// ключа Key изменено, добавлено или удалено.
+type Change struct {
+	Path string   `json:"path"`
+	Op   ChangeOp `json:"op"`
+	// Old и New — нормализованные значения для показа (JSON-литерал, после редакции ADR-0022). Пусты у Sensitive.
+	Old       string        `json:"old,omitempty"`
+	New       string        `json:"new,omitempty"`
+	Sensitive bool          `json:"sensitive,omitempty"`
+	Key       string        `json:"key,omitempty"` // имя ключа: env-переменная, ключ ConfigMap, аннотация
+	Priority  Priority      `json:"priority"`
+	Source    *ChangeSource `json:"source,omitempty"`
+}
+
+// ItemResult — результат проверки одного ресурса baseline.
+type ItemResult struct {
+	Ref      Ref      `json:"ref"`
+	Status   Status   `json:"status"`
+	Reason   Reason   `json:"reason,omitempty"` // для StatusUnchecked
+	Priority Priority `json:"priority,omitempty"`
+	Changes  []Change `json:"changes,omitempty"`
+	// Suppressed — идентификаторы исключений, скрывших часть изменений этого ресурса.
+	Suppressed []string `json:"suppressed,omitempty"`
+}
+
+// Summary — счётчики результата: проверенные и пропущенные ресурсы с причинами.
+type Summary struct {
+	Total     int `json:"total"`
+	Matched   int `json:"matched"`
+	Changed   int `json:"changed"`
+	Missing   int `json:"missing"`
+	Unchecked int `json:"unchecked"`
+	// Checked — ресурсы, по которым получен ответ кластера (соответствует, изменён, отсутствует).
+	Checked           int            `json:"checked"`
+	UncheckedByReason map[Reason]int `json:"uncheckedByReason,omitempty"`
+	// SuppressedChanges — число изменений, скрытых действующими исключениями.
+	SuppressedChanges int `json:"suppressedChanges"`
+}
+
+// AppliedException — применённое исключение: видно в результате, сколько изменений оно скрыло.
+type AppliedException struct {
+	ID        string         `json:"id"`
+	Scope     ExceptionScope `json:"scope"`
+	Ref       Ref            `json:"ref"`
+	Path      string         `json:"path"`
+	Comment   string         `json:"comment"`
+	ExpiresAt *time.Time     `json:"expiresAt,omitempty"`
+	Hits      int            `json:"hits"`
+}
+
+// ExceptionReport — что произошло с исключениями при проверке.
+type ExceptionReport struct {
+	Applied []AppliedException `json:"applied,omitempty"`
+	// Expired — идентификаторы просроченных исключений: они не применялись.
+	Expired []string `json:"expired,omitempty"`
+}
+
+// Caveat — оговорка к результату, которая не делает ресурс «не проверенным», но влияет на доверие к нему.
+type Caveat string
+
+const (
+	// CaveatHPAUnreadable — не удалось прочитать HorizontalPodAutoscaler: spec.replicas сравнивался как есть,
+	// у нагрузок под HPA возможны ложные отличия.
+	CaveatHPAUnreadable Caveat = "hpa-unreadable"
+)
+
+// CheckResult — результат проверки по версии baseline (ADR-0027 §5).
+type CheckResult struct {
+	ID         string       `json:"id"`
+	BaselineID string       `json:"baselineId"`
+	VersionID  string       `json:"versionId"`
+	Scope      tenant.Scope `json:"scope"`
+	// RulesVersion — версия правил приложения, по которым выполнено сравнение; VersionRulesVersion — версия правил,
+	// с которыми создана версия baseline. При несовпадении сравнение не выполняется (все ресурсы «не проверено»).
+	RulesVersion        int       `json:"rulesVersion"`
+	VersionRulesVersion int       `json:"versionRulesVersion"`
+	CheckedAt           time.Time `json:"checkedAt"`
+	Initiator           string    `json:"initiator"`
+	CorrelationID       string    `json:"correlationId,omitempty"`
+
+	Summary    Summary         `json:"summary"`
+	Items      []ItemResult    `json:"items"`
+	Exceptions ExceptionReport `json:"exceptions"`
+	Caveats    []Caveat        `json:"caveats,omitempty"`
+}
+
+// Validate проверяет результат перед записью.
+func (r CheckResult) Validate() error {
+	if err := ValidateID(r.ID); err != nil {
+		return err
+	}
+	if err := ValidateID(r.BaselineID); err != nil {
+		return err
+	}
+	if err := ValidateID(r.VersionID); err != nil {
+		return err
+	}
+	if r.CheckedAt.IsZero() {
+		return fmt.Errorf("%w: a check result needs a time", ErrInvalid)
+	}
+	return nil
+}
+
+// Summarize возвращает метаданные результата для списков истории.
+func (r CheckResult) Summarize() ResultSummary {
+	return ResultSummary{
+		ID: r.ID, BaselineID: r.BaselineID, VersionID: r.VersionID, CheckedAt: r.CheckedAt,
+		Initiator: r.Initiator, RulesVersion: r.RulesVersion, Summary: r.Summary,
+	}
+}
+
+// ResultSummary — строка истории проверок: без списка ресурсов.
+type ResultSummary struct {
+	ID           string    `json:"id"`
+	BaselineID   string    `json:"baselineId"`
+	VersionID    string    `json:"versionId"`
+	CheckedAt    time.Time `json:"checkedAt"`
+	Initiator    string    `json:"initiator"`
+	RulesVersion int       `json:"rulesVersion"`
+	Summary      Summary   `json:"summary"`
+}
diff --git a/internal/baseline/types.go b/internal/baseline/types.go
new file mode 100644
index 00000000..2a7515b8
--- /dev/null
+++ b/internal/baseline/types.go
@@ -0,0 +1,364 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+// Package baseline — модель и хранилище baseline конфигурации (ADR-0027).
+//
+// Baseline — данные Kubron, а не объект кластера: набор неизменяемых версий, каждая из которых — нормализованный
+// снимок живого состояния ресурсов. Пакет описывает типы и узкий интерфейс хранилища Backend (ADR-0026 §4) с двумя
+// реализациями (файловая — здесь, PostgreSQL — в internal/pgstore). Сравнение и нормализацию делает internal/drift.
+//
+// Правила пакета:
+//   - значения, способные нести секрет, хранятся только как keyed hash (HashedValue); Salt и Fields не попадают в журнал
+//     (LogValue, String), а в аудит и результаты проверок содержимое не входит;
+//   - пакет не импортирует платформу операционных модулей и клиентов Kubernetes: tenant.Scope приходит параметром.
+package baseline
+
+import (
+	"crypto/hmac"
+	"fmt"
+	"log/slog"
+	"strings"
+	"time"
+
+	"github.com/24DSO-lab/kubron/internal/tenant"
+)
+
+// SourceLiveSnapshot — источник версии в MVP: снимок живого состояния по явному действию пользователя.
+const SourceLiveSnapshot = "live-snapshot"
+
+// Ref — ссылка на ресурс: group/version/kind, namespace и имя. Namespace пуст у кластерных ресурсов.
+type Ref struct {
+	Group     string `json:"group,omitempty"`
+	Version   string `json:"version"`
+	Kind      string `json:"kind"`
+	Namespace string `json:"namespace,omitempty"`
+	Name      string `json:"name"`
+}
+
+// Key — идентичность ресурса без версии API: версия при обновлении кластера меняется, а ресурс остаётся тем же.
+func (r Ref) Key() string {
+	return r.Group + "/" + r.Kind + "/" + r.Namespace + "/" + r.Name
+}
+
+// String — читаемая запись «apps/v1 Deployment ns/name» (для сообщений; содержимого объектов не несёт).
+func (r Ref) String() string {
+	gv := r.Version
+	if r.Group != "" {
+		gv = r.Group + "/" + r.Version
+	}
+	name := r.Name
+	if r.Namespace != "" {
+		name = r.Namespace + "/" + r.Name
+	}
+	return gv + " " + r.Kind + " " + name
+}
+
+// Validate проверяет, что заполнены вид и имя.
+func (r Ref) Validate() error {
+	if r.Version == "" || r.Kind == "" || r.Name == "" {
+		return fmt.Errorf("%w: a resource reference needs version, kind and name", ErrInvalid)
+	}
+	return nil
+}
+
+// Baseline — документ baseline: область, набор ресурсов и указатель на активную версию. Версии лежат отдельно и не
+// меняются; менять документ допустимо (смена активной версии).
+type Baseline struct {
+	ID    string       `json:"id"`
+	Scope tenant.Scope `json:"scope"`
+	Name  string       `json:"name"`
+	// Область: пространства имён и селектор меток, по которым выбираются ресурсы, и допустимые типы (пусто — все
+	// типы MVP). Refs — разрешённый набор ресурсов, который снимается в новую версию.
+	Namespaces      []string  `json:"namespaces,omitempty"`
+	Selector        string    `json:"selector,omitempty"`
+	Kinds           []string  `json:"kinds,omitempty"`
+	Refs            []Ref     `json:"refs"`
+	ActiveVersionID string    `json:"activeVersionId"`
+	CreatedBy       string    `json:"createdBy"`
+	CreatedAt       time.Time `json:"createdAt"`
+}
+
+// Validate проверяет обязательные поля документа.
+func (b Baseline) Validate() error {
+	if err := ValidateID(b.ID); err != nil {
+		return err
+	}
+	if !b.Scope.Valid() {
+		return ErrInvalidScope
+	}
+	if strings.TrimSpace(b.Name) == "" {
+		return fmt.Errorf("%w: a baseline needs a name", ErrInvalid)
+	}
+	if b.ActiveVersionID != "" {
+		if err := ValidateID(b.ActiveVersionID); err != nil {
+			return err
+		}
+	}
+	for _, r := range b.Refs {
+		if err := r.Validate(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Version — неизменяемая версия baseline. Salt и Objects чувствительны: в журнал и ответы API они не попадают.
+type Version struct {
+	ID           string `json:"id"`
+	BaselineID   string `json:"baselineId"`
+	Seq          int    `json:"seq"`
+	RulesVersion int    `json:"rulesVersion"`
+	Source       string `json:"source"`
+	Author       string `json:"author"`
+	Comment      string `json:"comment"`
+	// CreatedAt хранится с точностью до микросекунды в UTC: так одинаково в файлах и в PostgreSQL.
+	CreatedAt time.Time `json:"createdAt"`
+	// Salt — 32 случайных байта, ключ HMAC значений этой версии. Хранится вместе с версией (в server — зашифрованно).
+	Salt    []byte   `json:"salt"`
+	Objects []Object `json:"objects"`
+}
+
+// Validate проверяет версию перед записью.
+func (v Version) Validate() error {
+	if err := ValidateID(v.ID); err != nil {
+		return err
+	}
+	if err := ValidateID(v.BaselineID); err != nil {
+		return err
+	}
+	if v.Seq < 1 {
+		return fmt.Errorf("%w: the version number must be positive", ErrInvalid)
+	}
+	if v.Source != SourceLiveSnapshot {
+		return fmt.Errorf("%w: unsupported version source", ErrInvalid)
+	}
+	if len(v.Salt) == 0 {
+		return fmt.Errorf("%w: a version needs a salt", ErrInvalid)
+	}
+	for _, o := range v.Objects {
+		if err := o.Ref.Validate(); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// Summary возвращает метаданные версии без Salt и Objects.
+func (v Version) Summary() VersionSummary {
+	return VersionSummary{
+		ID: v.ID, BaselineID: v.BaselineID, Seq: v.Seq, RulesVersion: v.RulesVersion, Source: v.Source,
+		Author: v.Author, Comment: v.Comment, CreatedAt: v.CreatedAt, ObjectCount: len(v.Objects),
+	}
+}
+
+// String и GoString не печатают соль и поля: версия может случайно попасть в %v или в сообщение об ошибке.
+func (v Version) String() string {
+	return fmt.Sprintf("baseline version %s (baseline %s, #%d, %d objects)", v.ID, v.BaselineID, v.Seq, len(v.Objects))
+}
+
+// GoString — то же для %#v.
+func (v Version) GoString() string { return v.String() }
+
+// LogValue — запись для slog: идентификаторы и счётчики, без Salt и Objects.
+func (v Version) LogValue() slog.Value {
+	return slog.GroupValue(
+		slog.String("id", v.ID), slog.String("baseline_id", v.BaselineID), slog.Int("seq", v.Seq),
+		slog.Int("rules_version", v.RulesVersion), slog.Int("objects", len(v.Objects)),
+		slog.String("salt", "[REDACTED]"),
+	)
+}
+
+// VersionSummary — метаданные версии для списков и истории (без соли и содержимого).
+type VersionSummary struct {
+	ID           string    `json:"id"`
+	BaselineID   string    `json:"baselineId"`
+	Seq          int       `json:"seq"`
+	RulesVersion int       `json:"rulesVersion"`
+	Source       string    `json:"source"`
+	Author       string    `json:"author"`
+	Comment      string    `json:"comment"`
+	CreatedAt    time.Time `json:"createdAt"`
+	ObjectCount  int       `json:"objectCount"`
+}
+
+// Object — нормализованный объект версии: путь поля → значение (плоская карта, пути строит internal/drift).
+type Object struct {
+	Ref    Ref              `json:"ref"`
+	Fields map[string]Field `json:"fields"`
+}
+
+// String и GoString не печатают значения полей.
+func (o Object) String() string {
+	return fmt.Sprintf("baseline object %s (%d fields)", o.Ref, len(o.Fields))
+}
+
+// GoString — то же для %#v.
+func (o Object) GoString() string { return o.String() }
+
+// LogValue — запись для slog без значений полей.
+func (o Object) LogValue() slog.Value {
+	return slog.GroupValue(slog.String("ref", o.Ref.String()), slog.Int("fields", len(o.Fields)))
+}
+
+// Field — значение листа нормализованного объекта: либо JSON-литерал (Plain), либо keyed hash (Hash).
+// Пустой Plain означает, что значение хранится только как hash.
+type Field struct {
+	// Plain — нормализованное значение как JSON-литерал: "nginx:1.25", 3, true, null, {} или [].
+	Plain string `json:"p,omitempty"`
+	// Hash — HMAC-SHA256 значения с солью версии (ADR-0027 §4); содержимое не восстанавливается.
+	Hash *HashedValue `json:"h,omitempty"`
+}
+
+// Sensitive сообщает, что значение хранится только как hash.
+func (f Field) Sensitive() bool { return f.Hash != nil }
+
+// Equal сравнивает значения: литералы — как строки, hash — через hmac.Equal (постоянное время).
+// Литерал и hash не равны никогда.
+func (f Field) Equal(g Field) bool {
+	switch {
+	case f.Hash != nil && g.Hash != nil:
+		return hmac.Equal(f.Hash.HMAC, g.Hash.HMAC)
+	case f.Hash == nil && g.Hash == nil:
+		return f.Plain == g.Plain
+	default:
+		return false
+	}
+}
+
+// String и GoString не печатают ни значение, ни hash.
+func (f Field) String() string {
+	if f.Hash != nil {
+		return "[HASHED]"
+	}
+	return f.Plain
+}
+
+// GoString — то же для %#v.
+func (f Field) GoString() string { return "baseline.Field{" + f.String() + "}" }
+
+// LogValue — запись для slog: hash скрыт, литерал показан (он уже прошёл редакцию при нормализации).
+func (f Field) LogValue() slog.Value {
+	if f.Hash != nil {
+		return slog.StringValue("[HASHED]")
+	}
+	return slog.StringValue(f.Plain)
+}
+
+// HashedValue — keyed hash значения.
+type HashedValue struct {
+	HMAC []byte `json:"hmac"`
+}
+
+// String и GoString не печатают байты hash.
+func (HashedValue) String() string { return "[HASHED]" }
+
+// GoString — то же для %#v.
+func (HashedValue) GoString() string { return "baseline.HashedValue{[HASHED]}" }
+
+// LogValue — запись для slog.
+func (HashedValue) LogValue() slog.Value { return slog.StringValue("[HASHED]") }
+
+// ExceptionScope — к чему относится исключение.
+type ExceptionScope string
+
+const (
+	// ExceptionResource — игнорировать путь для одного ресурса (group, kind, namespace, name).
+	ExceptionResource ExceptionScope = "resource"
+	// ExceptionKind — игнорировать путь для типа (group, kind) в namespace; пустой namespace — во всех.
+	ExceptionKind ExceptionScope = "kind"
+)
+
+// Exception — пользовательское исключение из сравнения (ADR-0027 §3). Комментарий обязателен, срок необязателен;
+// просроченное исключение не применяется. Хранится отдельным документом, привязанным к baseline и версии.
+type Exception struct {
+	ID    string         `json:"id"`
+	Scope ExceptionScope `json:"scope"`
+	// Ref задаёт цель: для ExceptionResource — ресурс целиком, для ExceptionKind — Group, Kind и Namespace
+	// (Version и Name игнорируются).
+	Ref Ref `json:"ref"`
+	// Path — путь, который не сравнивается: совпадающий путь и всё, что лежит под ним.
+	Path      string     `json:"path"`
+	Comment   string     `json:"comment"`
+	ExpiresAt *time.Time `json:"expiresAt,omitempty"`
+	CreatedBy string     `json:"createdBy"`
+	CreatedAt time.Time  `json:"createdAt"`
+}
+
+// MaxPathLength — предел длины пути исключения и комментария по размеру защищает хранилище от мусора.
+const (
+	MaxPathLength    = 512
+	MaxCommentLength = 2000
+)
+
+// Validate проверяет исключение перед записью.
+func (e Exception) Validate() error {
+	if err := ValidateID(e.ID); err != nil {
+		return err
+	}
+	switch e.Scope {
+	case ExceptionResource:
+		if e.Ref.Kind == "" || e.Ref.Name == "" {
+			return fmt.Errorf("%w: a resource exception needs kind and name", ErrInvalid)
+		}
+	case ExceptionKind:
+		if e.Ref.Kind == "" {
+			return fmt.Errorf("%w: a kind exception needs a kind", ErrInvalid)
+		}
+	default:
+		return fmt.Errorf("%w: unknown exception scope", ErrInvalid)
+	}
+	if e.Path == "" || len(e.Path) > MaxPathLength || hasControl(e.Path) {
+		return fmt.Errorf("%w: the exception path is empty, too long or has control characters", ErrInvalid)
+	}
+	if strings.TrimSpace(e.Comment) == "" {
+		return fmt.Errorf("%w: an exception needs a comment", ErrInvalid)
+	}
+	if len(e.Comment) > MaxCommentLength {
+		return fmt.Errorf("%w: the exception comment is too long", ErrInvalid)
+	}
+	return nil
+}
+
+// Expired сообщает, что срок исключения к моменту now истёк (граница не включается: в момент ExpiresAt уже не действует).
+func (e Exception) Expired(now time.Time) bool {
+	return e.ExpiresAt != nil && !now.Before(*e.ExpiresAt)
+}
+
+// Matches сообщает, относится ли исключение к ресурсу ref (без учёта пути).
+func (e Exception) Matches(ref Ref) bool {
+	if e.Ref.Group != ref.Group || e.Ref.Kind != ref.Kind {
+		return false
+	}
+	switch e.Scope {
+	case ExceptionResource:
+		return e.Ref.Namespace == ref.Namespace && e.Ref.Name == ref.Name
+	case ExceptionKind:
+		return e.Ref.Namespace == "" || e.Ref.Namespace == ref.Namespace
+	default:
+		return false
+	}
+}
+
+// CoversPath сообщает, что путь исключения совпадает с path или является его предком (по границе сегмента).
+func (e Exception) CoversPath(path string) bool {
+	if path == e.Path {
+		return true
+	}
+	if !strings.HasPrefix(path, e.Path) {
+		return false
+	}
+	switch path[len(e.Path)] { // длина проверена: path длиннее e.Path
+	case '.', '[':
+		return true
+	}
+	return false
+}
+
+func hasControl(s string) bool {
+	for _, r := range s {
+		if r < 0x20 || r == 0x7f {
+			return true
+		}
+	}
+	return false
+}
