+
+	// Неизвестная версия и невалидное исключение.
+	wantErr(t, e.Backend.PutExceptions(ctx, s, b.ID, baseline.NewID(), []baseline.Exception{a}), baseline.ErrNotFound)
+	noComment := newException("spec.replicas", t0)
+	noComment.Comment = "  "
