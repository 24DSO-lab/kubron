+	must(t, e.Backend.PutExceptions(ctx, s, b.ID, vs[0].ID, []baseline.Exception{newException("spec.replicas", t0)}))
+	res := newResult(b.ID, vs[0].ID, t0)
+	must(t, e.Backend.AppendResult(ctx, s, res))
