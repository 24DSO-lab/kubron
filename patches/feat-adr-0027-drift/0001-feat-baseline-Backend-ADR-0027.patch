+	c.ExpiresAt = nil
+	must(t, e.Backend.PutExceptions(ctx, s, b.ID, vs[0].ID, []baseline.Exception{a, c}))
+	got, err = e.Backend.GetExceptions(ctx, s, b.ID, vs[0].ID)
