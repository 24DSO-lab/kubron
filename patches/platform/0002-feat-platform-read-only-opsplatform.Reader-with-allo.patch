+// slowDiscovery блокирует вызовы до закрытия unblock.
+type slowDiscovery struct {
+	*discfake.FakeDiscovery
+	unblock chan struct{}
+}
+
+func (d *slowDiscovery) ServerVersion() (*version.Info, error) {
+	<-d.unblock
+	return &version.Info{GitVersion: "v1.30.0"}, nil
+}
