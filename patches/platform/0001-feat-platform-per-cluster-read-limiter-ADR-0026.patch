diff --git a/internal/opsplatform/limiter.go b/internal/opsplatform/limiter.go
new file mode 100644
index 00000000..cd006e7e
--- /dev/null
+++ b/internal/opsplatform/limiter.go
@@ -0,0 +1,111 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package opsplatform
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strconv"
+	"sync"
+)
+
+// Лимит одновременных чтений одного кластера операционными модулями (ADR-0026, «Решено при согласовании»).
+const (
+	// DefaultClusterConcurrency — стартовое значение: 4 одновременных чтения на кластер.
+	DefaultClusterConcurrency = 4
+	// MaxClusterConcurrency — верхняя граница настройки: лимит защищает kube-apiserver, а не снимается конфигурацией.
+	MaxClusterConcurrency = 32
+	// EnvClusterConcurrency — переменная окружения, меняющая лимит.
+	EnvClusterConcurrency = "KUBRON_OPS_CLUSTER_CONCURRENCY"
+)
+
+// ClusterLimiter ограничивает число одновременных чтений одного кластера. Лимит действует в рамках процесса:
+// на уровне нескольких реплик он не координируется (в первой версии нет фоновых запусков, нагрузку создают
+// только пользователи). Запись о кластере живёт, пока есть ожидающие или держащие слот: map не растёт.
+type ClusterLimiter struct {
+	limit int
+
+	mu      sync.Mutex
+	entries map[string]*limiterEntry
+}
+
+type limiterEntry struct {
+	slots chan struct{} // ёмкость = limit; занятый слот — элемент в канале
+	refs  int           // число держащих и ожидающих
+}
+
+// NewClusterLimiter создаёт лимитер. limit < 1 заменяется значением по умолчанию, больше Max — границей.
+func NewClusterLimiter(limit int) *ClusterLimiter {
+	if limit < 1 {
+		limit = DefaultClusterConcurrency
+	}
+	return &ClusterLimiter{limit: min(limit, MaxClusterConcurrency), entries: map[string]*limiterEntry{}}
+}
+
+// Limit возвращает действующий лимит на кластер.
+func (l *ClusterLimiter) Limit() int { return l.limit }
+
+// Acquire занимает слот чтения кластера clusterID и возвращает функцию освобождения. Ожидание прерывается отменой
+// ctx: тогда слот не занят, а ошибка содержит ErrUnavailable и причину ctx (errors.Is работает с обеими).
+// release безопасно вызывать несколько раз; обязателен ровно один вызов (defer release()).
+func (l *ClusterLimiter) Acquire(ctx context.Context, clusterID string) (release func(), err error) {
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("%w: %w", ErrUnavailable, err)
+	}
+	l.mu.Lock()
+	e := l.entries[clusterID]
+	if e == nil {
+		e = &limiterEntry{slots: make(chan struct{}, l.limit)}
+		l.entries[clusterID] = e
+	}
+	e.refs++
+	l.mu.Unlock()
+
+	select {
+	case e.slots <- struct{}{}:
+	case <-ctx.Done():
+		l.unref(clusterID, e)
+		return nil, fmt.Errorf("%w: %w", ErrUnavailable, ctx.Err())
+	}
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			<-e.slots
+			l.unref(clusterID, e)
+		})
+	}, nil
+}
+
+func (l *ClusterLimiter) unref(clusterID string, e *limiterEntry) {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if e.refs--; e.refs <= 0 && l.entries[clusterID] == e {
+		delete(l.entries, clusterID)
+	}
+}
+
+// tracked возвращает число кластеров с активными или ожидающими чтениями (для тестов и диагностики).
+func (l *ClusterLimiter) tracked() int {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	return len(l.entries)
+}
+
+// ConcurrencyFromEnv читает лимит из KUBRON_OPS_CLUSTER_CONCURRENCY. Пустое, нечисловое или меньшее 1 значение
+// даёт значение по умолчанию; значение больше MaxClusterConcurrency ограничивается им.
+func ConcurrencyFromEnv(getenv func(string) string) int {
+	n, err := strconv.Atoi(getenv(EnvClusterConcurrency))
+	if err != nil || n < 1 {
+		return DefaultClusterConcurrency
+	}
+	return min(n, MaxClusterConcurrency)
+}
+
+var sharedLimiter = sync.OnceValue(func() *ClusterLimiter {
+	return NewClusterLimiter(ConcurrencyFromEnv(os.Getenv))
+})
+
+// SharedLimiter возвращает общий лимитер процесса: один счётчик на кластер для всех сессий и операций.
+func SharedLimiter() *ClusterLimiter { return sharedLimiter() }
diff --git a/internal/opsplatform/limiter_test.go b/internal/opsplatform/limiter_test.go
new file mode 100644
index 00000000..1804ac25
--- /dev/null
+++ b/internal/opsplatform/limiter_test.go
@@ -0,0 +1,170 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package opsplatform
+
+import (
+	"context"
+	"errors"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestLimiterNeverExceedsLimit(t *testing.T) {
+	t.Parallel()
+	const limit, workers = 3, 40
+	l := NewClusterLimiter(limit)
+	var cur, peak atomic.Int32
+	var wg sync.WaitGroup
+	for range workers {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			release, err := l.Acquire(t.Context(), "c1")
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			n := cur.Add(1)
+			for {
+				p := peak.Load()
+				if n <= p || peak.CompareAndSwap(p, n) {
+					break
+				}
+			}
+			time.Sleep(time.Millisecond)
+			cur.Add(-1)
+			release()
+		}()
+	}
+	wg.Wait()
+	if got := peak.Load(); got > limit {
+		t.Fatalf("peak concurrency %d exceeds limit %d", got, limit)
+	}
+	if l.tracked() != 0 {
+		t.Fatalf("limiter leaked %d cluster entries", l.tracked())
+	}
+}
+
+func TestLimiterClustersAreIndependent(t *testing.T) {
+	t.Parallel()
+	l := NewClusterLimiter(1)
+	relA, err := l.Acquire(t.Context(), "a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer relA()
+	ctx, cancel := context.WithTimeout(t.Context(), time.Second)
+	defer cancel()
+	relB, err := l.Acquire(ctx, "b")
+	if err != nil {
+		t.Fatalf("a busy cluster a must not block cluster b: %v", err)
+	}
+	relB()
+}
+
+func TestLimiterCancelWhileWaiting(t *testing.T) {
+	t.Parallel()
+	l := NewClusterLimiter(1)
+	hold, err := l.Acquire(t.Context(), "c")
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(t.Context())
+	errc := make(chan error, 1)
+	go func() {
+		_, err := l.Acquire(ctx, "c")
+		errc <- err
+	}()
+	time.Sleep(20 * time.Millisecond)
+	cancel()
+	err = <-errc
+	if !errors.Is(err, ErrUnavailable) || !errors.Is(err, context.Canceled) {
+		t.Fatalf("Acquire after cancel = %v, want ErrUnavailable and context.Canceled", err)
+	}
+	hold()
+	if l.tracked() != 0 {
+		t.Fatalf("slot or entry leaked after cancel: %d", l.tracked())
+	}
+	// слот снова доступен
+	rel, err := l.Acquire(t.Context(), "c")
+	if err != nil {
+		t.Fatalf("slot not reusable: %v", err)
+	}
+	rel()
+}
+
+func TestLimiterAlreadyCanceled(t *testing.T) {
+	t.Parallel()
+	l := NewClusterLimiter(1)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	if _, err := l.Acquire(ctx, "c"); !errors.Is(err, ErrUnavailable) {
+		t.Fatalf("got %v", err)
+	}
+	if l.tracked() != 0 {
+		t.Fatal("entry leaked")
+	}
+}
+
+func TestLimiterReleaseIsIdempotent(t *testing.T) {
+	t.Parallel()
+	l := NewClusterLimiter(1)
+	rel, err := l.Acquire(t.Context(), "c")
+	if err != nil {
+		t.Fatal(err)
+	}
+	rel()
+	rel() // второй вызов не должен освободить чужой слот
+	r1, err := l.Acquire(t.Context(), "c")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r1()
+	ctx, cancel := context.WithTimeout(t.Context(), 30*time.Millisecond)
+	defer cancel()
+	if _, err := l.Acquire(ctx, "c"); err == nil {
+		t.Fatal("double release freed a slot that belongs to another holder")
+	}
+}
+
+func TestConcurrencyFromEnv(t *testing.T) {
+	t.Parallel()
+	tests := []struct {
+		name, val string
+		want      int
+	}{
+		{"empty", "", DefaultClusterConcurrency},
+		{"garbage", "many", DefaultClusterConcurrency},
+		{"zero", "0", DefaultClusterConcurrency},
+		{"negative", "-3", DefaultClusterConcurrency},
+		{"ok", "7", 7},
+		{"capped", "1000", MaxClusterConcurrency},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			got := ConcurrencyFromEnv(func(k string) string {
+				if k != EnvClusterConcurrency {
+					t.Errorf("unexpected variable %q", k)
+				}
+				return tc.val
+			})
+			if got != tc.want {
+				t.Fatalf("got %d, want %d", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestNewClusterLimiterBounds(t *testing.T) {
+	t.Parallel()
+	if got := NewClusterLimiter(0).Limit(); got != DefaultClusterConcurrency {
+		t.Fatalf("0 -> %d", got)
+	}
+	if got := NewClusterLimiter(999).Limit(); got != MaxClusterConcurrency {
+		t.Fatalf("999 -> %d", got)
+	}
+}
