{
  "Kind": "cloud-eks",
  "Params": {
    "authenticator": "aws-iam-authenticator",
    "cluster-name": "legacy-eks",
    "cluster.certificate-authority-data": "Q0EtREFUQQ==",
    "cluster.server": "https://k8s.example.com:6443",
    "role-arn": "arn:aws:iam::123456789012:role/Dev"
  },
  "Exec": {
    "apiVersion": "client.authentication.k8s.io/v1beta1",
    "command": "aws-iam-authenticator",
    "args": [
      "token",
      "-i",
      "legacy-eks",
      "-r",
      "arn:aws:iam::123456789012:role/Dev"
    ],
    "interactiveMode": "IfAvailable"
  }
}
