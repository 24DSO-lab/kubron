apiVersion: v1
kind: Config
current-context: ctx
clusters:
- name: c
  cluster:
    server: https://k8s.example.com:6443
    certificate-authority-data: Q0EtREFUQQ==
contexts:
- name: ctx
  context:
    cluster: c
    user: rancher-user
users:
- name: rancher-user
  user:
    token: kubeconfig-u-abcde:fakerancherTOKEN
