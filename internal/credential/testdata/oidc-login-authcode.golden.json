  "Exec": {
    "apiVersion": "client.authentication.k8s.io/v1beta1",
    "command": "kubectl",
    "args": [
      "oidc-login",
      "get-token",
      "--oidc-issuer-url",
      "https://idp.example.com",
      "--oidc-client-id",
      "kubron",
      "--oidc-use-pkce",
      "--certificate-authority-data=SURQLUNB",
      "--listen-address=127.0.0.1:8000",
      "--listen-address=127.0.0.1:18000",
      "--oidc-redirect-url-hostname=localhost",
      "--skip-open-browser",
      "--oidc-auth-request-extra-params=prompt=login"
