{
  "Kind": "oidc",
  "Params": {
    "auth-request-extra-params": "prompt=login",
    "ca-data": "SURQLUNB",
    "client-id": "kubron",
    "cluster.certificate-authority-data": "Q0EtREFUQQ==",
    "cluster.server": "https://k8s.example.com:6443",
    "grant": "authcode",
    "issuer-url": "https://idp.example.com",
    "listen-address": "127.0.0.1:8000,127.0.0.1:18000",
    "redirect-url-hostname": "localhost",
