{
  "Kind": "oidc",
  "Params": {
    "client-id": "kubron",
    "cluster.certificate-authority-data": "Q0EtREFUQQ==",
    "cluster.server": "https://k8s.example.com:6443",
    "grant": "authcode",
    "issuer-url": "https://idp.example.com"
  },
  "Exec": {
    "apiVersion": "client.authentication.k8s.io/v1beta1",
    "command": "kubectl",
    "args": [
      "oidc-login",
      "get-token",
      "--oidc-issuer-url=https://idp.example.com",
      "--oidc-client-id=kubron",
      "--grant-type=auto"
    ],
    "interactiveMode": "IfAvailable"
  }
}
