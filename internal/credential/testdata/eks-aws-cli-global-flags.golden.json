{
  "Kind": "cloud-eks",
  "Params": {
    "authenticator": "aws-cli",
    "cluster-name": "demo",
    "cluster.certificate-authority-data": "Q0EtREFUQQ==",
    "cluster.server": "https://k8s.example.com:6443",
    "region": "us-east-2"
  },
  "Exec": {
    "apiVersion": "client.authentication.k8s.io/v1beta1",
    "command": "/usr/local/bin/aws",
    "args": [
      "--region",
      "us-east-2",
      "eks",
      "get-token",
      "--cluster-name=demo",
      "--output",
      "json"
    ],
    "env": {
      "AWS_DEFAULT_REGION": "us-east-2"
    },
    "interactiveMode": "IfAvailable"
  }
}
