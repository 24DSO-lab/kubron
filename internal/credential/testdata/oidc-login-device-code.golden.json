{
  "Kind": "oidc",
  "Params": {
    "client-id": "cli",
    "cluster.certificate-authority-data": "Q0EtREFUQQ==",
    "cluster.server": "https://k8s.example.com:6443",
    "grant": "device-code",
    "issuer-url": "https://login.example.com/realms/x"
  },
  "Exec": {
    "apiVersion": "client.authentication.k8s.io/v1beta1",
    "command": "kubectl",
    "args": [
      "oidc-login",
      "get-token",
      "--oidc-issuer-url=https://login.example.com/realms/x",
      "--oidc-client-id=cli",
      "--grant-type=device-code"
    ],
    "interactiveMode": "IfAvailable",
    "installHint": "kubelogin is required: kubectl krew install oidc-login\n"
  }
}
