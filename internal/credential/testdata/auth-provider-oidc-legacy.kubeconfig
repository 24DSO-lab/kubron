apiVersion: v1
kind: Config
current-context: ctx
clusters:
- name: c
  cluster:
    server: https://k8s.example.com:6443
    certificate-authority-data: Q0EtREFUQQ==
contexts:
- name: ctx
  context:
    cluster: c
    user: u
users:
- name: u
  user:
    auth-provider:
      name: oidc
      config:
        idp-issuer-url: https://idp.example.com
        client-id: kubron
        client-secret: CLIENT-SECRET-2
        id-token: ID.TOKEN.VALUE
        refresh-token: REFRESH-TOKEN-VALUE
        idp-certificate-authority-data: SURQLUNB
        extra-scopes: groups,email
