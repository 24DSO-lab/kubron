# apps/v1 Deployment prod/web
metadata.annotations["example.com/owner"] = "team-web"
metadata.annotations["meta.helm.sh/release-name"] = "web"
metadata.labels.app = "web"
metadata.labels.tier = "frontend"
metadata.labels["app.kubernetes.io/managed-by"] = "Helm"
spec.replicas = 3
spec.selector.matchLabels.app = "web"
spec.strategy.type = "RollingUpdate"
spec.template.metadata.labels.app = "web"
spec.template.metadata.labels.tier = "frontend"
spec.template.spec.containers[name=sidecar].image = "registry.example.com/web/log-shipper:latest"
spec.template.spec.containers[name=sidecar].name = "sidecar"
spec.template.spec.containers[name=web].env[name=API_KEY].name = "API_KEY"
spec.template.spec.containers[name=web].env[name=API_KEY].valueFrom.secretKeyRef.key = "key"
spec.template.spec.containers[name=web].env[name=API_KEY].valueFrom.secretKeyRef.name = "web-api"
spec.template.spec.containers[name=web].env[name=DB_PASSWORD].name = "DB_PASSWORD"
spec.template.spec.containers[name=web].env[name=DB_PASSWORD].value = HASH:30186cc5
spec.template.spec.containers[name=web].env[name=LOG_LEVEL].name = "LOG_LEVEL"
spec.template.spec.containers[name=web].env[name=LOG_LEVEL].value = HASH:41fd874c
spec.template.spec.containers[name=web].env[name=POD_NAME].name = "POD_NAME"
spec.template.spec.containers[name=web].env[name=POD_NAME].valueFrom.fieldRef.fieldPath = "metadata.name"
spec.template.spec.containers[name=web].image = "registry.example.com/web/app:3.8.2"
spec.template.spec.containers[name=web].livenessProbe.httpGet.path = "/healthz"
spec.template.spec.containers[name=web].livenessProbe.httpGet.port = 8080
spec.template.spec.containers[name=web].livenessProbe.initialDelaySeconds = 10
spec.template.spec.containers[name=web].name = "web"
spec.template.spec.containers[name=web].ports[containerPort=8080].containerPort = 8080
spec.template.spec.containers[name=web].ports[containerPort=8080].name = "http"
spec.template.spec.containers[name=web].ports[containerPort=9090].containerPort = 9090
spec.template.spec.containers[name=web].ports[containerPort=9090].name = "metrics"
spec.template.spec.containers[name=web].readinessProbe.httpGet.path = "/ready"
spec.template.spec.containers[name=web].readinessProbe.httpGet.port = "http"
spec.template.spec.containers[name=web].readinessProbe.periodSeconds = 5
spec.template.spec.containers[name=web].readinessProbe.timeoutSeconds = 2
spec.template.spec.containers[name=web].resources.limits.cpu = "500m"
spec.template.spec.containers[name=web].resources.limits.memory = "512Mi"
spec.template.spec.containers[name=web].resources.requests.cpu = "250m"
spec.template.spec.containers[name=web].resources.requests.memory = "256Mi"
spec.template.spec.containers[name=web].securityContext.allowPrivilegeEscalation = false
spec.template.spec.containers[name=web].securityContext.runAsNonRoot = true
spec.template.spec.containers[name=web].volumeMounts[mountPath=/etc/web].mountPath = "/etc/web"
spec.template.spec.containers[name=web].volumeMounts[mountPath=/etc/web].name = "config"
spec.template.spec.containers[name=web].volumeMounts[mountPath=/etc/web].readOnly = true
spec.template.spec.containers[name=web].volumeMounts[mountPath=/tmp].mountPath = "/tmp"
spec.template.spec.containers[name=web].volumeMounts[mountPath=/tmp].name = "tmp"
spec.template.spec.initContainers.@order = ["[name=wait-db]","[name=migrate]"]
spec.template.spec.initContainers[name=migrate].args[0] = "--up"
spec.template.spec.initContainers[name=migrate].image = "registry.example.com/web/migrate:2.4.1"
spec.template.spec.initContainers[name=migrate].name = "migrate"
spec.template.spec.initContainers[name=wait-db].command[0] = "sh"
spec.template.spec.initContainers[name=wait-db].command[1] = "-c"
spec.template.spec.initContainers[name=wait-db].command[2] = "until nc -z db 5432; do sleep 1; done"
spec.template.spec.initContainers[name=wait-db].image = "busybox:1.36"
spec.template.spec.initContainers[name=wait-db].name = "wait-db"
spec.template.spec.serviceAccountName = "web"
spec.template.spec.tolerations[0].effect = "NoExecute"
spec.template.spec.tolerations[0].key = "node.kubernetes.io/not-ready"
spec.template.spec.tolerations[0].operator = "Exists"
spec.template.spec.tolerations[0].tolerationSeconds = 300
spec.template.spec.tolerations[1].effect = "NoExecute"
spec.template.spec.tolerations[1].key = "node.kubernetes.io/unreachable"
spec.template.spec.tolerations[1].operator = "Exists"
spec.template.spec.tolerations[1].tolerationSeconds = 300
spec.template.spec.volumes[name=config].configMap.name = "web-config"
spec.template.spec.volumes[name=config].name = "config"
spec.template.spec.volumes[name=tmp].emptyDir = {}
spec.template.spec.volumes[name=tmp].name = "tmp"
