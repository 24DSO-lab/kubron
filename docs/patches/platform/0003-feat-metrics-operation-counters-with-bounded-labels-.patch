From 9a86169e35729dcccaf039c97c28c7bb7a10cf2c Mon Sep 17 00:00:00 2001
From: Vadim <vmilyash@mts.ru>
Date: Wed, 11 Nov 2026 07:31:55 +0700
Subject: [PATCH 03/10] feat(metrics): operation counters with bounded labels
 (ADR-0026)

kubron_ops_operations_total{module,operation,status} and a duration histogram; values outside the code-defined identifier shape collapse to other.

Signed-off-by: Vadim <vmilyash@mts.ru>
---
 internal/metrics/metrics.go      |  5 +++-
 internal/metrics/metrics_test.go | 21 +++++++++++++
 internal/metrics/ops.go          | 51 ++++++++++++++++++++++++++++++++
 3 files changed, 76 insertions(+), 1 deletion(-)
 create mode 100644 internal/metrics/ops.go

diff --git a/internal/metrics/metrics.go b/internal/metrics/metrics.go
index 5886bf39..90759c9f 100644
--- a/internal/metrics/metrics.go
+++ b/internal/metrics/metrics.go
@@ -53,6 +53,8 @@ type Metrics struct {
 	rpcTotal    *prometheus.CounterVec
 	rpcDuration *prometheus.HistogramVec
 	rateLimited prometheus.Counter
+	opsTotal    *prometheus.CounterVec
+	opsDuration *prometheus.HistogramVec
 }
 
 // New создаёт реестр. version — версия сборки (build info); snap вызывается при каждом скрейпе.
@@ -71,10 +73,11 @@ func New(version string, snap func() Snapshot) *Metrics {
 		Namespace: Namespace, Name: "http_rate_limited_total",
 		Help: "Responses with status 429 (any endpoint).",
 	})
+	m.opsTotal, m.opsDuration = newOpsCollectors()
 	m.reg.MustRegister(
 		collectors.NewGoCollector(),
 		collectors.NewProcessCollector(collectors.ProcessCollectorOpts{}),
-		m.rpcTotal, m.rpcDuration, m.rateLimited,
+		m.rpcTotal, m.rpcDuration, m.rateLimited, m.opsTotal, m.opsDuration,
 		newSnapshotCollector(version, snap),
 	)
 	return m
diff --git a/internal/metrics/metrics_test.go b/internal/metrics/metrics_test.go
index 7297dfae..97b22848 100644
--- a/internal/metrics/metrics_test.go
+++ b/internal/metrics/metrics_test.go
@@ -108,3 +108,24 @@ func TestOnlyGetAndHead(t *testing.T) {
 		t.Fatalf("POST /metrics: %d", rec.Code)
 	}
 }
+
+func TestObserveOpLabelsAreBounded(t *testing.T) {
+	m := New("dev", func() Snapshot { return Snapshot{} })
+	m.ObserveOp("incident", "open", "ok", time.Millisecond)
+	m.ObserveOp("incident", "open", "failed", time.Millisecond)
+	// значения, не похожие на идентификаторы из кода, сворачиваются
+	m.ObserveOp("alice@example.com", "prod-cluster-of-alice/ns", "weird status", time.Millisecond)
+	body := scrape(t, m)
+	for _, want := range []string{
+		`kubron_ops_operations_total{module="incident",operation="open",status="ok"} 1`,
+		`kubron_ops_operations_total{module="incident",operation="open",status="failed"} 1`,
+		`kubron_ops_operations_total{module="other",operation="other",status="other"} 1`,
+	} {
+		if !strings.Contains(body, want) {
+			t.Errorf("missing %q in:\n%s", want, body)
+		}
+	}
+	if strings.Contains(body, "alice") || strings.Contains(body, "prod-cluster") {
+		t.Fatalf("a private value leaked into labels:\n%s", body)
+	}
+}
diff --git a/internal/metrics/ops.go b/internal/metrics/ops.go
new file mode 100644
index 00000000..faa89c50
--- /dev/null
+++ b/internal/metrics/ops.go
@@ -0,0 +1,51 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package metrics
+
+import (
+	"regexp"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+// Метрики операционных модулей (ADR-0026 §6). Лейблы — только модуль, операция и статус: значения задаёт код,
+// а не пользователь. Ни пользователей, ни кластеров, ни namespace в лейблах нет (ADR-0022); всё, что не похоже на
+// идентификатор из кода, сворачивается в "other", чтобы кардинальность оставалась ограниченной.
+
+// opLabel — допустимое значение лейбла module и operation.
+var opLabel = regexp.MustCompile(`^[a-z][a-z0-9_]{0,31}$`)
+
+// opStatuses — фиксированный набор статусов операции.
+var opStatuses = map[string]bool{"ok": true, "partial": true, "failed": true, "canceled": true}
+
+func newOpsCollectors() (*prometheus.CounterVec, *prometheus.HistogramVec) {
+	total := prometheus.NewCounterVec(prometheus.CounterOpts{
+		Namespace: Namespace, Name: "ops_operations_total",
+		Help: "Operational module operations by module, operation and status.",
+	}, []string{"module", "operation", "status"})
+	dur := prometheus.NewHistogramVec(prometheus.HistogramOpts{
+		Namespace: Namespace, Name: "ops_operation_duration_seconds",
+		Help:    "Operational module operation duration by module and operation.",
+		Buckets: []float64{.01, .05, .25, 1, 2.5, 5, 15, 60},
+	}, []string{"module", "operation"})
+	return total, dur
+}
+
+func safeOpLabel(v string) string {
+	if opLabel.MatchString(v) {
+		return v
+	}
+	return "other"
+}
+
+// ObserveOp учитывает одну операцию операционного модуля (opsplatform.Observer).
+func (m *Metrics) ObserveOp(module, operation, status string, d time.Duration) {
+	if !opStatuses[status] {
+		status = "other"
+	}
+	module, operation = safeOpLabel(module), safeOpLabel(operation)
+	m.opsTotal.WithLabelValues(module, operation, status).Inc()
+	m.opsDuration.WithLabelValues(module, operation).Observe(d.Seconds())
+}
