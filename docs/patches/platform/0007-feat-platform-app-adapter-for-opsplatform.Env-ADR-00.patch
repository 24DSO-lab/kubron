diff --git a/internal/app/ops_env.go b/internal/app/ops_env.go
new file mode 100644
index 00000000..b615cd6f
--- /dev/null
+++ b/internal/app/ops_env.go
@@ -0,0 +1,107 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package app
+
+import (
+	"context"
+	"errors"
+
+	"github.com/24DSO-lab/kubron/internal/audit"
+	"github.com/24DSO-lab/kubron/internal/auth"
+	"github.com/24DSO-lab/kubron/internal/opsplatform"
+)
+
+// Организация и команда десктопа: каталога команд нет, но tenant.Scope обязан быть полным (ADR-0026 §4).
+const (
+	localOrgID       = "local"
+	localDefaultTeam = "default"
+)
+
+// orgIDer — хранилище, знающее организацию каталога (PostgreSQL).
+type orgIDer interface{ OrgID() string }
+
+// opsEnv — реализация opsplatform.Env поверх вида App. Все пути идут через существующие слои: права — auth.Service,
+// подключение — Manager.ConnectionFor (ConfigFor), аудит — audit.Logger, события — Manager.Notify (владелец вида).
+type opsEnv struct{ a *App }
+
+func (e opsEnv) Check(p auth.Permission, clusterID string) (auth.Actor, error) {
+	if e.a.auth == nil {
+		return auth.Actor{}, e.a.authUnavailable()
+	}
+	return e.a.auth.CheckCluster(p, clusterID)
+}
+
+func (e opsEnv) OrgID() string {
+	if o, ok := e.a.store.(orgIDer); ok {
+		if id := o.OrgID(); id != "" {
+			return id
+		}
+		return ""
+	}
+	return localOrgID
+}
+
+func (e opsEnv) DefaultTeam() string {
+	if t := e.a.defaultTeam(); t != "" {
+		return t
+	}
+	if e.a.dir != nil {
+		return "" // сервисный режим без команды по умолчанию: пустой scope будет отклонён
+	}
+	return localDefaultTeam
+}
+
+func (e opsEnv) SessionID() string { return e.a.sessionID }
+
+func (e opsEnv) Clients(_ context.Context, clusterID string) (opsplatform.Clients, error) {
+	if e.a.k8sMgr == nil {
+		return opsplatform.Clients{}, errors.New("cluster manager is not available")
+	}
+	e.a.bindAuthSession()
+	conn, err := e.a.k8sMgr.ConnectionFor(clusterID)
+	if err != nil {
+		return opsplatform.Clients{}, err
+	}
+	// Интерфейсы заполняются только при наличии клиента: nil-указатель в интерфейсе не должен выглядеть живым.
+	var c opsplatform.Clients
+	if conn.DynamicClient != nil {
+		c.Dynamic = conn.DynamicClient
+	}
+	if conn.Client != nil {
+		c.Core = conn.Client
+	}
+	if conn.DiscoveryClient != nil {
+		c.Discovery = conn.DiscoveryClient
+	}
+	if c.Dynamic == nil || c.Core == nil || c.Discovery == nil {
+		return opsplatform.Clients{}, errors.New("cluster connection is incomplete")
+	}
+	return c, nil
+}
+
+func (e opsEnv) RecordAudit(ev audit.Event) {
+	if e.a.audit != nil {
+		e.a.audit.Record(ev)
+	}
+}
+
+// Notify адресует событие владельцу вида: в вебе это его сессия (Event Hub), в десктопе — единственное окно.
+// Широковещания нет: у корневого вида веб-сервера уведомителя нет, и событие никуда не уходит.
+func (e opsEnv) Notify(event string, data ...any) {
+	if e.a.k8sMgr != nil {
+		e.a.k8sMgr.Notify(event, data...)
+	}
+}
+
+// opsProvider возвращает Provider платформы для этого вида. Лимитер общий для процесса (SharedLimiter).
+func (a *App) opsProvider() opsplatform.Provider {
+	return opsplatform.NewProvider(opsEnv{a}, opsplatform.Config{})
+}
+
+// beginOp начинает операцию операционного модуля: проверка права и принадлежности кластера команде, tenant.Scope из
+// каталога, контекст с deadline. Вызывающий обязан закрыть операцию: defer op.End(err). Метод — общая точка входа
+// для делегатов модулей (Dev 2–4); в RPC не публикуется (имя с маленькой буквы).
+func (a *App) beginOp(req opsplatform.OpRequest) (context.Context, *opsplatform.Op, error) {
+	return a.opsProvider().Begin(a.baseContext(), req)
+}
diff --git a/internal/app/ops_env_test.go b/internal/app/ops_env_test.go
new file mode 100644
index 00000000..3cb2def2
--- /dev/null
+++ b/internal/app/ops_env_test.go
@@ -0,0 +1,94 @@
+// Copyright 2026 The Kubron Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package app
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/24DSO-lab/kubron/internal/audit"
+	"github.com/24DSO-lab/kubron/internal/auth"
+	"github.com/24DSO-lab/kubron/internal/k8s"
+	"github.com/24DSO-lab/kubron/internal/opsplatform"
+)
+
+// beginOp: чужой кластер неотличим от несуществующего, а отказ по праву пишется в аудит; до проверки подключение
+// к кластеру не строится (иначе чужая команда могла бы вызвать обращение к кластеру).
+func TestBeginOpChecksTeamAndPermissionBeforeConnecting(t *testing.T) {
+	k8s.SetKubronDir(t.TempDir())
+	t.Cleanup(func() { k8s.SetKubronDir("") })
+	a := newAuditedApp(t)
+	a.auth.SetOnLogout(nil)
+
+	if _, err := a.auth.Setup("admin", testPass); err != nil {
+		t.Fatal(err)
+	}
+	u, err := a.auth.CreateUser("ops", testPass, auth.RoleUser)
+	if err != nil {
+		t.Fatal(err)
+	}
+	red, err := k8s.AddClusterFromText(kubeconfigForTest, k8s.ClusterSettings{DisplayName: "red", ContextName: "ctx"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	blue, err := k8s.AddClusterFromText(kubeconfigForTest, k8s.ClusterSettings{DisplayName: "blue", ContextName: "ctx"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.auth.SetAccess(auditAccess{
+		clusters: map[string]string{red.ID: "red", blue.ID: "blue"},
+		roles:    map[string]map[string]auth.Role{u.ID: {"red": auth.RoleUser}},
+	})
+	a.auth.Logout()
+	if _, err := a.auth.Login(t.Context(), "ops", testPass); err != nil {
+		t.Fatal(err)
+	}
+	if err := a.auth.ChangePassword(t.Context(), testPass, "another-pass-2"); err != nil {
+		t.Fatal(err)
+	}
+
+	// Чужая команда и несуществующий кластер.
+	for _, id := range []string{blue.ID, "ghost"} {
+		_, op, err := a.beginOp(opsplatform.OpRequest{Module: "incident", Operation: "open", ClusterID: id, Permission: auth.PermRead})
+		if !errors.Is(err, auth.ErrClusterNotFound) || op != nil {
+			t.Fatalf("%s: op=%v err=%v, want ErrClusterNotFound", id, op, err)
+		}
+	}
+	// Член команды без права diagnostics.logs.
+	_, op, err := a.beginOp(opsplatform.OpRequest{Module: "diagnose", Operation: "logs", ClusterID: red.ID, Permission: auth.PermDiagnosticsLogs})
+	if !errors.Is(err, auth.ErrForbidden) || op != nil {
+		t.Fatalf("op=%v err=%v, want ErrForbidden", op, err)
+	}
+	last := events(t, a)[0]
+	if last.Result != audit.ResultDenied || last.Action != "DiagnoseLogs" || last.TeamID != "red" || last.ClusterID != red.ID {
+		t.Fatalf("denial record: %+v", last)
+	}
+}
+
+func TestOpsEnvScopeInDesktopMode(t *testing.T) {
+	a := newAuditedApp(t)
+	env := opsEnv{a}
+	if env.OrgID() != localOrgID || env.DefaultTeam() != localDefaultTeam {
+		t.Fatalf("desktop scope = %q/%q", env.OrgID(), env.DefaultTeam())
+	}
+}
+
+// Событие уходит только через уведомитель вида-владельца; у вида без уведомителя оно не доставляется никому.
+func TestOpsEnvNotifyIsAddressedToTheView(t *testing.T) {
+	root := newAuditedApp(t)
+	viewA, viewB := *root, *root
+	viewA.k8sMgr, viewB.k8sMgr = root.k8sMgr.ForSession(), root.k8sMgr.ForSession()
+	var gotA, gotB []string
+	viewA.k8sMgr.SetNotifier(func(event string, data ...any) { gotA = append(gotA, event) })
+	viewB.k8sMgr.SetNotifier(func(event string, data ...any) { gotB = append(gotB, event) })
+
+	opsEnv{&viewA}.Notify("incident:updated", "inc-1")
+	if len(gotA) != 1 || len(gotB) != 0 {
+		t.Fatalf("A=%v B=%v: the event must reach only the owner view", gotA, gotB)
+	}
+	opsEnv{root}.Notify("incident:updated", "inc-2") // у корневого вида нет уведомителя: никому
+	if len(gotA) != 1 || len(gotB) != 0 {
+		t.Fatalf("a view without a notifier must not broadcast: A=%v B=%v", gotA, gotB)
+	}
+}
