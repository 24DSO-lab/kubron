Preview отдаётся фронтенду как есть, поэтому поля получили json-теги.
Исключение по типу сохраняет группу и пространство имён (см. Exception.Matches).

Signed-off-by: Vadim <vmilyash@mts.ru>
---
 internal/drift/engine.go  | 22 +++++++++++-----------
 internal/drift/service.go |  2 +-
 2 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/internal/drift/engine.go b/internal/drift/engine.go
index 9168fdc8..20767ec2 100644
--- a/internal/drift/engine.go
+++ b/internal/drift/engine.go
@@ -318,18 +318,18 @@ func (e *Engine) snapshotOf(c *collected) Snapshot {
 
 // Preview — предпросмотр новой версии: что будет зафиксировано и чем это отличается от предыдущей версии.
 type Preview struct {
-	Token       string
-	ExpiresAt   time.Time
-	Objects     int
-	Hashed      int
-	Skipped     []Skip
-	HasPrevious bool
+	Token       string    `json:"token"`
+	ExpiresAt   time.Time `json:"expiresAt"`
+	Objects     int       `json:"objects"`
+	Hashed      int       `json:"hashed"`
+	Skipped     []Skip    `json:"skipped,omitempty"`
+	HasPrevious bool      `json:"hasPrevious"`
 	// RulesChanged — предыдущая версия снята по другим правилам: сравнение с ней невозможно.
-	RulesChanged bool
-	Added        []baseline.Ref
-	Removed      []baseline.Ref
-	Changed      []baseline.ItemResult
-	Unchanged    int
+	RulesChanged bool                  `json:"rulesChanged"`
+	Added        []baseline.Ref        `json:"added,omitempty"`
+	Removed      []baseline.Ref        `json:"removed,omitempty"`
+	Changed      []baseline.ItemResult `json:"changed,omitempty"`
+	Unchanged    int                   `json:"unchanged"`
 }
 
 func (e *Engine) tokenMAC(fp, bind string, exp int64) string {
diff --git a/internal/drift/service.go b/internal/drift/service.go
index 67640717..e4ce641c 100644
--- a/internal/drift/service.go
+++ b/internal/drift/service.go
@@ -310,7 +310,7 @@ func (s *Service) AddException(ctx context.Context, sess Session, baselineID str
 		Comment: strings.TrimSpace(in.Comment), ExpiresAt: in.ExpiresAt, CreatedBy: sess.Actor, CreatedAt: baseline.Normalize(s.now()),
 	}
 	if ex.Scope == baseline.ExceptionKind {
-		ex.Ref = baseline.Ref{Kind: in.Ref.Kind} // исключение по типу не привязано к ресурсу
+		ex.Ref = baseline.Ref{Group: in.Ref.Group, Kind: in.Ref.Kind, Namespace: in.Ref.Namespace} // по типу: без версии API и имени
 	}
 	if err := ex.Validate(); err != nil {
 		return baseline.Exception{}, err
