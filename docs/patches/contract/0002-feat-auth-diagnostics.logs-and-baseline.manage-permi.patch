+	PermBaselineManage Permission = "baseline.manage"
 )
 
 // allPermissions — полный список прав. Администратор получает все.
@@ -55,6 +62,8 @@ var allPermissions = []Permission{
 	PermClusterManage,
 	PermUsersManage,
 	PermAuditRead,
+	PermDiagnosticsLogs,
+	PermBaselineManage,
