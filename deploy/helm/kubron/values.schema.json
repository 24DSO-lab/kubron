{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kubron chart values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "intOrString": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "k8sObjectList": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "egressTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "egressApi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "to": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "except": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowCluster": {
          "type": "boolean"
        }
      }
    },
    "egressIdp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "to": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "properties": {
    "global": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Replicas of kubron-server on one PostgreSQL (ADR-0016). 2 by default; 1 is allowed."
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "$ref": "#/definitions/k8sObjectList"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretKey": {
              "type": "string",
              "minLength": 1
            },
            "databaseUrl": {
              "type": "string",
              "minLength": 1
            },
            "previousSecretKey": {
              "type": "string"
            },
            "dbListenUrl": {
              "type": "string"
            }
          }
        },
        "create": {
          "type": "boolean"
        },
        "values": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretKey": {
              "type": "string"
            },
            "databaseUrl": {
              "type": "string"
            }
          }
        }
      }
    },
    "kubron": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trustProxy": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "drainDelay": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$",
          "description": "Go duration, 0 to 60s: pause between SIGTERM and closing connections."
        },
        "auditRetention": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$",
          "description": "Go duration of at least 24h; empty keeps the audit log forever."
        },
        "sessionTTL": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$",
          "description": "Go duration, for example 12h."
        },
        "maxTerminals": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxLogStreams": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "maxPortForwards": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "terminalMaxDuration": {
          "type": "string"
        },
        "terminalIdleTimeout": {
          "type": "string"
        },
        "disablePortForward": {
          "type": "boolean"
        },
        "disableNodeShell": {
          "type": "boolean"
        },
        "disableExec": {
          "type": "boolean"
        },
        "extraEnv": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "",
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "logFormat": {
          "type": "string",
          "enum": [
            "",
            "json",
            "text"
          ]
        },
        "auditStdout": {
          "type": "boolean"
        },
        "allowedHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s,]+$"
          },
          "description": "Allowed Host header values; the chart adds ingress hosts and *.pf.<baseDomain>."
        },
        "clusterAddrPolicy": {
          "type": "string",
          "enum": [
            "",
            "off",
            "permissive",
            "strict"
          ],
          "description": "KUBRON_CLUSTER_ADDR_POLICY; empty keeps the server default (permissive in the service mode)."
        },
        "clusterAddrAllowCidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s,]+$"
          },
          "description": "KUBRON_CLUSTER_ADDR_ALLOW_CIDRS exceptions."
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^/"
                    },
                    "pathType": {
                      "type": "string",
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "secretName": {
                "type": "string"
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "inCluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "extraRules": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "profile": {
          "type": "string",
          "enum": [
            "readonly",
            "operator",
            "custom"
          ]
        },
        "allowSecretsRead": {
          "type": "boolean"
        },
        "readonlyRules": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "operatorRules": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "customRules": {
          "$ref": "#/definitions/k8sObjectList"
        },
        "existingClusterRole": {
          "type": "string"
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "writableDirs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?$"
            }
          }
        },
        "tmp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sizeLimit": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(Ki|Mi|Gi|Ti|k|M|G|T)?$"
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "startupProbe": {
      "$ref": "#/definitions/probe"
    },
    "livenessProbe": {
      "$ref": "#/definitions/probe"
    },
    "readinessProbe": {
      "$ref": "#/definitions/probe"
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSurge": {
              "$ref": "#/definitions/intOrString"
            },
            "maxUnavailable": {
              "$ref": "#/definitions/intOrString"
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "$ref": "#/definitions/intOrString"
        },
        "maxUnavailable": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/intOrString"
            }
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "type": "string",
          "enum": [
            "",
            "AlwaysAllow",
            "IfHealthyBudget"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/definitions/k8sObjectList"
            }
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "to": {
                  "$ref": "#/definitions/k8sObjectList"
                }
              }
            },
            "postgres": {
              "$ref": "#/definitions/egressTarget"
            },
            "clusterApi": {
              "$ref": "#/definitions/egressApi"
            },
            "extra": {
              "$ref": "#/definitions/k8sObjectList"
            },
            "idp": {
              "$ref": "#/definitions/egressIdp"
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "$ref": "#/definitions/k8sObjectList"
            }
          }
        }
      }
    },
    "podAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "podLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "nodeSelector": {
      "$ref": "#/definitions/stringMap"
    },
    "tolerations": {
      "$ref": "#/definitions/k8sObjectList"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "$ref": "#/definitions/k8sObjectList"
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraVolumes": {
      "$ref": "#/definitions/k8sObjectList"
    },
    "extraVolumeMounts": {
      "$ref": "#/definitions/k8sObjectList"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "$ref": "#/definitions/stringMap"
            }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespace": {
              "type": "string"
            },
            "labels": {
              "$ref": "#/definitions/stringMap"
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "relabelings": {
              "$ref": "#/definitions/k8sObjectList"
            },
            "metricRelabelings": {
              "$ref": "#/definitions/k8sObjectList"
            }
          }
        }
      }
    },
    "portForward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseDomain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]*$"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "",
            "https",
            "http"
          ]
        },
        "idleTimeout": {
          "type": "string"
        },
        "maxDuration": {
          "type": "string"
        }
      }
    }
  }
}
